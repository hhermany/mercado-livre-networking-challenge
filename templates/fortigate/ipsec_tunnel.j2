config vpn ipsec phase1-interface
    edit "{{ tunnel_name }}"
        set interface "{{ wan_interface }}"
        set remote-gw {{ remote_public_ip }}
        set ike-version 2
        set proposal aes256-sha256
        set dhgrp 14
        set psksecret "{{ psk }}"
    next
end

config vpn ipsec phase2-interface
    edit "{{ tunnel_name }}-p2"
        set phase1name "{{ tunnel_name }}"
        set proposal aes256-sha256
    next
end
